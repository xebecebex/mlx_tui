# Activate provider: mlx | openai-compatible | anthropic
WORKBENCH_PROVIDER=mlx

# Default local model. 
WORKBENCH_MODEL = mlx-community/Qwen2.5-Coder-3B-Instruct-4bit

# Local MLX bridge
MLX_BRIDGE_URL=http://127.0.0.1:8765

# Workspase
WORKBENCH_WORKSPACE=.

MLX_MODEL = mlx-community/Qwen2.5-Coder-3B-Instruct-4bit
MLX_MAX_TOKENS=256
PYTHON_BIN=.venv/bin/python